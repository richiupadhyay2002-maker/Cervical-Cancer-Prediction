# ============================================================================
# .dockerignore - Files to exclude from Docker build context
# ============================================================================
# This reduces build context size and speeds up Docker builds

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/

# Git
.git/
.gitignore

# Documentation
README.md
README1.md
*.md

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/

# Data files (not needed in container - mounted as volumes)
*.csv
*.npy
*.zip
extracted/

# MLflow (mounted as volumes instead)
mlruns/
!mlruns/1/models/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test files
test_*.py
check_*.py
fix_*.py
generate_*.py
rewrite_*.py
output_*.py

# Temporary files
temp/
tmp/